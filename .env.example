# LLM used for the decision step: "fake" (rule-based, no key, no network) or "openai".
LLM_MODE=fake

# Only needed when LLM_MODE=openai. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_S=30

# Agent loop limits.
AGENT_MAX_STEPS=8
AGENT_MAX_DECISION_ATTEMPTS=3

# Share of fake Helpdesk calls that fail with a temporary error (0 to 1), to exercise retries.
HELPDESK_FAILURE_RATE=0.2

# Temporal server the worker connects to, and the task queue it polls.
# Docker Compose overrides TEMPORAL_ADDRESS with its own service name (temporal:7233).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tickets

# Log level of the API and the worker: DEBUG, INFO, WARNING or ERROR. Logs are JSON lines on stdout.
LOG_LEVEL=INFO
